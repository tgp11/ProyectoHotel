<Window x:Class="HOTELINTERFAZ.Ventanas.NuevoEmpleado"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:HOTELINTERFAZ.Ventanas"
        mc:Ignorable="d"
        Title="NuevoEmpleado" Height="350" Width="400">
    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="Nombre"/>
            <TextBox Text="{Binding NombreNuevo}" />

            <TextBlock Text="DNI"/>
            <TextBox Text="{Binding DniNuevo}" />

            <TextBlock Text="Email"/>
            <TextBox Text="{Binding EmailNuevo}" />

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordBox"/>

            <DatePicker SelectedDate="{Binding FechaNacimientoNuevo}" />

            <TextBlock Text="Sexo"/>
            <ComboBox SelectedValue="{Binding SexoNuevo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="Masculino" Tag="M"/>
                <ComboBoxItem Content="Femenino" Tag="F"/>
                <ComboBoxItem Content="Otro" Tag="X"/>
            </ComboBox>

            <CheckBox Content="Administrador"
                      IsChecked="{Binding AdministradorNuevo}"/>

            <Button Content="Seleccionar Foto"
                    Click="SeleccionarFoto_Click"/>

            <Button Content="Crear Empleado"
                    Margin="0,20,0,0"
                    Click="CrearEmpleado_Click"/>

        </StackPanel>

    </Grid>
</Window>
