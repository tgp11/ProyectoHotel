<Window x:Class="HOTELINTERFAZ.Ventanas.BuscarReservasParaCancelarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancelar Reserva"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Búsqueda por DNI -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="DNI del cliente" Margin="0,0,0,2"/>
                <TextBox x:Name="txtDni" Width="200" VerticalContentAlignment="Center"/>
            </StackPanel>
            <Button Content="Buscar"
                    Width="100"
                    Margin="12,18,0,0"
                    Click="Buscar_Click2"/>
        </StackPanel>

        <!-- DataGrid de reservas -->
        <DataGrid x:Name="dgReservas"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ColumnWidth="SizeToCells"
                  MinWidth="400"
                  MinHeight="300" >

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="DNI" Binding="{Binding Cliente.Dni}" Width="Auto"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nombre}" Width="Auto"/>
                <DataGridTextColumn Header="Habitación" Binding="{Binding HabitacionId}" Width="Auto"/>
                <DataGridTextColumn Header="Entrada" Binding="{Binding FechaEntrada, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                <DataGridTextColumn Header="Salida" Binding="{Binding FechaSalida, StringFormat=dd/MM/yyyy}" Width="Auto"/>
                <DataGridTextColumn Header="Personas" Binding="{Binding Personas}" Width="Auto"/>
                <DataGridCheckBoxColumn Header="Cancelada" Binding="{Binding Cancelacion}" Width="Auto"/>
                <DataGridTemplateColumn Header="Acción" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Cancelar"
                                    Click="Cancelar_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Window>
